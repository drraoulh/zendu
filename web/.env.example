SUPABASE_SERVICE_ROLE_KEY=""

# Mode de fonctionnement. "live" (ou une INTERAC_DEPOSIT_EMAIL renseignée) = mode réel : plus aucune
# simulation (ni paiement par carte simulé, ni versement simulé). Seuls les envois depuis le Canada
# par Interac sont ouverts ; MTN Cameroun passe par l'API MoMo avec des clés de PRODUCTION
# (MTN_TARGET_ENV différent de "sandbox"), tout le reste est versé par l'équipe depuis /admin/transferts.
APP_MODE=""
# Nom du titulaire du compte Interac de réception, affiché au client (sa banque montrera ce nom).
INTERAC_DEPOSIT_NAME=""
# Plafonds de sécurité en mode réel : par client (CAD, 24 h et 30 jours) et par versement Mobile Money (FCFA).
TRANSFER_DAILY_LIMIT_CAD="3000"
TRANSFER_MONTHLY_LIMIT_CAD="10000"
MOBILE_MONEY_MAX_XAF="500000"
# Secret de la tâche planifiée Vercel /api/cron/expire (transferts non payés après 24 h → expirés).
CRON_SECRET=""

# Virement Interac (Canada) : adresse de dépôt du compte d'entreprise (dépôt automatique activé).
# Le client y envoie le montant avec la référence du transfert en message ; l'équipe confirme la
# réception dans /admin/transferts. Vide = mode démo (réception simulable depuis l'appli).
INTERAC_DEPOSIT_EMAIL=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

MTN_SUBSCRIPTION_KEY=""
MTN_API_USER=""
MTN_API_KEY=""
MTN_TARGET_ENV="sandbox"
MTN_CURRENCY="EUR"
MTN_BASE_URL="https://sandbox.momodeveloper.mtn.com/disbursement"
MTN_CALLBACK_URL="http://localhost:3000/api/webhooks/momo"
MTN_CALLBACK_HOST="localhost:3000"
# Tests en mode réel avec la sandbox MTN (MTN_TARGET_ENV="sandbox") : seuls ces comptes (courriels, séparés
# par des virgules) passent par MoMo sandbox, qui ne verse AUCUN argent réel. Les autres clients restent
# en versement manuel. Vide = aucune sandbox en mode réel.
MTN_SANDBOX_TESTERS=""

# Orange Money Cameroun (API OM-API Manager, versement « Cashin » vers les portefeuilles Orange Money).
# Clés de l'application : https://apistore.orange.cm/devportal/home (onglet Sandbox ou Production).
# X-AUTH-TOKEN, numéro du compte canal et PIN : transmis par Orange Money. Ne jamais les mettre dans le code.
# Sandbox et production ont les mêmes URL : ORANGE_TARGET_ENV dit quelles clés sont en place
# (en mode réel, le sandbox ne sert qu'aux comptes listés dans MTN_SANDBOX_TESTERS).
ORANGE_CONSUMER_KEY=""
ORANGE_CONSUMER_SECRET=""
ORANGE_X_AUTH_TOKEN=""
ORANGE_CHANNEL_MSISDN=""
ORANGE_PIN=""
ORANGE_TARGET_ENV="sandbox"
ORANGE_NOTIF_URL="http://localhost:3000/api/webhooks/orange"

# Jeton opérateur (long et aléatoire) pour clôturer les virements bancaires traités manuellement
# depuis /admin (POST /api/transfers/[id]/bank-payout). Vide = action désactivée.
ADMIN_API_TOKEN=""

AUTO_PAYOUT="true"

# --- Application mobile WorldSoft Transfer (une solution PWFINTECH) ---
# Liens des stores. Vides = boutons « Bientôt » + liste d'attente sur /application.
NEXT_PUBLIC_APP_STORE_URL=""
NEXT_PUBLIC_PLAY_STORE_URL=""
# Écrans d'envoi web (/send, /transfers/*, /history, /refer, /login, /signup) : fermés au public
# par défaut (redirection 307 vers /application). "true" uniquement pour les démos et les tests.
# /api/**, /admin et /auth/callback ne sont jamais bloqués.
WEB_TRANSFERS_ENABLED="false"
# Même réglage côté navigateur : affiche Connexion / Mes transferts dans l'en-tête si "true".
NEXT_PUBLIC_WEB_TRANSFERS_ENABLED="false"

# --- Administration (/admin, /api/admin/**) ---
# Mot de passe unique de l'équipe (page /admin/login). Vide = admin fermé (« configurez ADMIN_PASSWORD »),
# sauf en NODE_ENV=development où il reste ouvert avec un bandeau d'avertissement.
# Identifiant de connexion (facultatif) : exigé avec le mot de passe s'il est défini.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Secret HMAC du cookie de session (32+ caractères aléatoires, ex. `openssl rand -hex 32`). Session : 12 h.
# OBLIGATOIRE en production (sinon l'admin reste fermé). En développement local seulement, vide = dérivé de ADMIN_PASSWORD.
# Mot de passe conseillé : 14 caractères ou plus (la page /admin/securite le signale sinon).
ADMIN_SESSION_SECRET=""
# Double authentification (facultatif, recommandé) : code à 6 chiffres d'une application d'authentification.
# Générer avec `node scripts/admin-totp-setup.mjs`, ajouter la clé dans l'application, puis la mettre ici.
ADMIN_TOTP_SECRET=""
# Comptes individuels : créés dans /admin/securite › Équipe. Dès qu'un compte actif existe, la connexion
# provisoire ADMIN_USERNAME / ADMIN_PASSWORD est refusée. Chaque personne active son code dans /admin/compte.
# Sous-domaine réservé à l'admin (ex. portailadmin.pwfintec.com) : ailleurs, /admin répond 404.
ADMIN_HOST=""
# Virements Interac : à partir de ce montant (CAD), deux personnes différentes doivent valider (défaut 1000).
INTERAC_DUAL_APPROVAL_CAD="1000"
# (ADMIN_API_TOKEN ci-dessus reste accepté en `Authorization: Bearer …` sur les API admin.)

# --- Comptes clients de l'application (/api/auth, /api/me, /admin/clients) ---
# "true" = identité validée automatiquement à la soumission (démo). Vide = validation par l'équipe dans /admin/clients.
KYC_AUTO_APPROVE=""

# --- Vérification d'identité Didit (https://business.didit.me) ---
# Clé API et identifiant du parcours (workflow) créés dans la console Didit. Vides = ancien parcours
# (déclaration simple validée par l'équipe dans /admin/clients). Déclarer le webhook
# https://<domaine>/api/webhooks/didit dans la console (événements : status.updated, data.updated,
# user.status.updated) et copier son secret ici. Obligatoire en mode réel : sans secret, les webhooks
# sont refusés (l'appli relit quand même le statut chez Didit).
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_WEBHOOK_SECRET=""
# Page de fin (défaut : NEXT_PUBLIC_APP_URL/kyc/termine).
DIDIT_CALLBACK_URL=""

