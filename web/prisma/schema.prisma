generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Beneficiary {
  id            String     @id @default(cuid())
  fullName      String
  phone         String
  network       String     @default("MTN")
  country       String     @default("CM")
  /// Virement bancaire uniquement (réseau de type "bank") — null pour mobile money / retrait.
  bankName      String?
  /// IBAN / RIB / numéro de compte, sans espaces, en majuscules.
  accountNumber String?
  /// Code SWIFT/BIC ou code banque/agence (facultatif).
  bankCode      String?
  createdAt     DateTime   @default(now())
  transfers     Transfer[]
}

model Quote {
  id               String    @id @default(cuid())
  corridorId       String    @default("CA-CM")
  sendCurrency     String    @default("CAD")
  receiveCurrency  String    @default("XAF")
  sendAmountCad    Float
  receiveAmountXaf Float
  rate             Float
  feeCad           Float
  totalCad         Float
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  transfer         Transfer?
}

model Transfer {
  id               String          @id @default(cuid())
  reference        String          @unique
  status           String          @default("awaiting_payment")
  corridorId       String          @default("CA-CM")
  sourceCountry    String          @default("CA")
  destCountry      String          @default("CM")
  sendCurrency     String          @default("CAD")
  receiveCurrency  String          @default("XAF")
  senderName       String
  senderEmail      String
  sendAmountCad    Float
  receiveAmountXaf Float
  rate             Float
  feeCad           Float
  totalCad         Float
  payInProvider    String          @default("mock")
  payInRef         String?
  payoutProvider   String          @default("mock_momo")
  payoutRef        String?
  failureReason    String?
  /// Client WorldSoft Transfer connecté (null pour un envoi sans compte depuis le site).
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteId          String?         @unique
  quote            Quote?          @relation(fields: [quoteId], references: [id])
  beneficiaryId    String
  beneficiary      Beneficiary     @relation(fields: [beneficiaryId], references: [id])
  events           TransferEvent[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  paidAt           DateTime?
  deliveredAt      DateTime?

  @@index([senderEmail])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model TransferEvent {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  type       String
  message    String
  createdAt  DateTime @default(now())

  @@index([transferId])
}

/// Liste d'attente de l'application mobile WorldSoft Transfer (page /application).
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  country   String?
  locale    String?
  source    String?
  createdAt DateTime @default(now())
}

/// Demandes de service déposées sur le site (POST /api/requests), traitées dans /admin/demandes.
/// kind : contact | shipping_quote | finance_appointment | tech_project
/// status : new | in_progress | answered | closed
model ServiceRequest {
  id        String     @id @default(cuid())
  /// Référence publique : CT-XXXXXX, SHQ-XXXXXX, FIN-XXXXXX, TECH-XXXXXX.
  reference String     @unique
  kind      String
  status    String     @default("new")
  name      String
  email     String
  phone     String?
  locale    String?
  /// Champs propres au type (voir src/lib/requests.ts).
  payload   Json
  /// Note interne de l'équipe (jamais exposée au public).
  adminNote String?
  /// Rendez-vous Finances uniquement : "YYYY-MM-DDTHH:mm" (heure de l'Est). Unique = pas de double
  /// réservation ; remis à null quand le rendez-vous est clos pour libérer le créneau.
  slotKey   String?    @unique
  shipments Shipment[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([kind])
  @@index([status])
  @@index([createdAt])
}

/// Colis Shipping suivis publiquement par numéro (GET /api/shipments/track).
/// mode : air | sea — status : received | in_transit | customs | out_for_delivery | delivered | exception
model Shipment {
  id                String          @id @default(cuid())
  /// Numéro public "PWS-#####".
  number            String          @unique
  requestId         String?
  request           ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  origin            String
  destination       String
  mode              String
  status            String          @default("received")
  weightKg          Float?
  estimatedDelivery DateTime?
  /// Privé : jamais renvoyé par l'API publique de suivi.
  recipientName     String?
  events            ShipmentEvent[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([requestId])
  @@index([status])
  @@index([createdAt])
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  label      String
  location   String?
  at         DateTime @default(now())

  @@index([shipmentId])
}

/// Compte client de l'application WorldSoft Transfer (POST /api/auth/*, /api/me/*), géré dans /admin/clients.
/// kycStatus : none | pending | verified | rejected — status : active | suspended
model Customer {
  id                 String            @id @default(cuid())
  email              String            @unique
  phone              String
  firstName          String
  lastName           String
  country            String
  region             String?
  birthDate          String?
  occupation         String?
  jobTitle           String?
  /// { line1, line2?, city, region, postalCode? }
  address            Json?
  /// scrypt$N$sel$hash (jamais renvoyé par les API).
  passwordHash       String
  /// Vrai après un mot de passe temporaire donné par l'équipe : changement imposé à la connexion.
  mustChangePassword Boolean           @default(false)
  passwordChangedAt  DateTime?
  kycStatus          String            @default("none")
  kycDocument        String?
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  /// Motif de refus ou note KYC visible par le client.
  kycNote            String?
  status             String            @default("active")
  marketing          Boolean           @default(false)
  /// Note interne de l'équipe (jamais exposée au client).
  adminNote          String?
  lastLoginAt        DateTime?
  sessions           CustomerSession[]
  transfers          Transfer[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([kycStatus])
  @@index([status])
  @@index([createdAt])
}

/// Session de l'application (jeton Bearer, seul son SHA-256 est stocké) = un « appareil connecté ».
model CustomerSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  device     String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([customerId])
}
