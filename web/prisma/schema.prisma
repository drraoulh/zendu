generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Beneficiary {
  id        String     @id @default(cuid())
  fullName  String
  phone     String
  network   String     @default("MTN")
  country   String     @default("CM")
  /// Virement bancaire uniquement (réseau de type "bank") — null pour mobile money / retrait.
  bankName      String?
  /// IBAN / RIB / numéro de compte, sans espaces, en majuscules.
  accountNumber String?
  /// Code SWIFT/BIC ou code banque/agence (facultatif).
  bankCode      String?
  createdAt DateTime   @default(now())
  transfers Transfer[]
}

model Quote {
  id               String     @id @default(cuid())
  corridorId       String     @default("CA-CM")
  sendCurrency     String     @default("CAD")
  receiveCurrency  String     @default("XAF")
  sendAmountCad    Float
  receiveAmountXaf Float
  rate             Float
  feeCad           Float
  totalCad         Float
  expiresAt        DateTime
  createdAt        DateTime   @default(now())
  transfer         Transfer?
}

model Transfer {
  id               String          @id @default(cuid())
  reference        String          @unique
  status           String          @default("awaiting_payment")
  corridorId       String          @default("CA-CM")
  sourceCountry    String          @default("CA")
  destCountry      String          @default("CM")
  sendCurrency     String          @default("CAD")
  receiveCurrency  String          @default("XAF")
  senderName       String
  senderEmail      String
  sendAmountCad    Float
  receiveAmountXaf Float
  rate             Float
  feeCad           Float
  totalCad         Float
  payInProvider    String          @default("mock")
  payInRef         String?
  payoutProvider   String          @default("mock_momo")
  payoutRef        String?
  failureReason    String?
  quoteId          String?         @unique
  quote            Quote?          @relation(fields: [quoteId], references: [id])
  beneficiaryId    String
  beneficiary      Beneficiary     @relation(fields: [beneficiaryId], references: [id])
  events           TransferEvent[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  paidAt           DateTime?
  deliveredAt      DateTime?

  @@index([senderEmail])
  @@index([status])
  @@index([createdAt])
}

model TransferEvent {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  type       String
  message    String
  createdAt  DateTime @default(now())

  @@index([transferId])
}
