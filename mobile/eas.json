{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APK_ARM64_ONLY": "1",
        "EXPO_PUBLIC_API_URL": "https://worldsofttransfer.com",
        "EXPO_PUBLIC_SITE_URL": "https://worldsofttransfer.com",
        "EXPO_PUBLIC_COMPANY_EMAIL": "support@worldsofttransfer.com",
        "EXPO_PUBLIC_COMPANY_PHONE": "+1 416 830 3459",
        "EXPO_PUBLIC_COMPANY_LEGAL_NAME": "Paul World Finances and Technologies Ltd."
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://worldsofttransfer.com",
        "EXPO_PUBLIC_SITE_URL": "https://worldsofttransfer.com",
        "EXPO_PUBLIC_COMPANY_EMAIL": "support@worldsofttransfer.com",
        "EXPO_PUBLIC_COMPANY_PHONE": "+1 416 830 3459",
        "EXPO_PUBLIC_COMPANY_LEGAL_NAME": "Paul World Finances and Technologies Ltd."
      }
    }
  },
  "submit": {
    "production": {}
  }
}
